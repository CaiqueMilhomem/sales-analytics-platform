# Copie este arquivo para ".env" e preencha com a connection string do seu
# banco Postgres na nuvem (Neon ou Supabase, plano gratuito).
# Nunca commitar o .env real -- ele já está no .gitignore.
# Usado tanto pelos scripts em scripts/ (psycopg2) quanto, futuramente, pela
# API em api/ (Etapa 3).

DATABASE_URL=postgresql://neondb_owner:npg_yc1XpxkJ8FVz@ep-bitter-flower-axevwdmf-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Opcional. Origens autorizadas a chamar a API (CORS), separadas por vírgula.
# "*" libera qualquer origem -- ok para desenvolvimento local, restrinja em produção.
CORS_ORIGINS=*

# Opcionais. Integração com a API de câmbio (AwesomeAPI -- pública, sem chave).
# Só precisa preencher se quiser mudar o padrão.
# CAMBIO_API_URL=https://economia.awesomeapi.com.br/json/last
# CAMBIO_TIMEOUT_SEGUNDOS=5
# CAMBIO_CACHE_TTL_SEGUNDOS=300
